{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@localapps/ui": ["./src"],
      "@localapps/ui/utils": ["./src/utils.ts"],
      "@localapps/ui/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
