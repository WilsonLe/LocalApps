{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@localapps/ui": ["../packages/ui/src"],
      "@localapps/ui/utils": ["../packages/ui/src/utils.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/workers"]
}
